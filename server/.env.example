# Copy to .env — only ANTHROPIC_API_KEY is required for live LLM features.
# The app boots and the test suite passes without it (LLM endpoints return a clear 502).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# No API key? Set LLM_MODE=mock for a deterministic demo client — the full UX works,
# every generated message is visibly labelled as demo output, and the same validation/
# audit fences apply. Explicit opt-in only.
LLM_MODE=live
DATABASE_URL=file:./dev.db
PORT=4100
